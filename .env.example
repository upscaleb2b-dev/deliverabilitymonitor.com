# --- GoHighLevel waitlist delivery -------------------------------------------
# Set ONE of the two options below. GHL_WEBHOOK_URL takes priority if both exist.

# Option 1 (easiest, no API key):
# In GHL, create a workflow with an "Inbound Webhook" trigger and paste its URL here.
GHL_WEBHOOK_URL=

# Option 2 (direct contact creation):
# Settings -> Private Integrations -> create a token with contacts.write scope.
GHL_API_TOKEN=

# GHL sub-account (location) ID. Defaults to this value in code if unset.
GHL_LOCATION_ID=rEOhehvSrqKntIWlFlWl
